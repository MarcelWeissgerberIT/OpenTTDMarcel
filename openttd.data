/* This file contains code to downgrade the API from 1.9 to 1.8. */

GSBridge.GetNameCompat1_8 <- GSBridge.GetName;
GSBridge.GetName <- function(bridge_id)
{
	return GSBridge.GetNameCompat1_8(bridge_id, GSVehicle.VT_RAIL);
}
